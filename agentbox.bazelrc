build --remote_header=x-buildbuddy-api-key=%{BUILDBUDDY_API_KEY}
build --experimental_platform_in_output_dir

build --bes_results_url=https://buildbuddy.buildbuddy.io/invocation/
build --bes_backend=grpcs://buildbuddy.buildbuddy.io

build --remote_cache=grpcs://buildbuddy.buildbuddy.io
build --remote_timeout=2m
